{
  "expo": {
    "name": "Друзья",
    "slug": "friends-notes",
    "owner": "kamon1996",
    "scheme": "friendsnotes",
    "version": "1.35.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kamon1996.friendsnotes",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "com.kamon1996.friendsnotes",
      "adaptiveIcon": {
        "backgroundColor": "#D05858",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#C4502F",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Чтобы быстро добавить друзей и их дни рождения из контактов."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Чтобы выбрать фото друга из галереи.",
          "cameraPermission": "Чтобы сфотографировать друга для аватара.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EE",
          "dark": {
            "backgroundColor": "#17130F"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "testorg-oz",
          "project": "friends-notes"
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Чтобы показывать дни рождения друзей в календаре телефона."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.3.21"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "dfc0aeba-21ab-471d-9968-3bde4741776e"
      },
      "sentry": {
        "dsn": "https://0d05ef48f99116f4e2667433677ebfdc@o4509005617037312.ingest.us.sentry.io/4512391090143232"
      }
    }
  }
}
